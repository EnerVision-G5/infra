# Déployé par le rôle Ansible "backup" — ne pas éditer sur l'hôte.
[Unit]
Description=EnerVision — planification du dump local des sauvegardes

[Timer]
OnCalendar={{ backup_dump_on_calendar }}
Persistent=true
RandomizedDelaySec={{ backup_randomized_delay_seconds }}

[Install]
WantedBy=timers.target

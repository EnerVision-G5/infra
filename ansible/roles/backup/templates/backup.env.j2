# Déployé par le rôle Ansible "backup" — ne pas éditer sur l'hôte.
# Environnement du conteneur restic : dépôt, clé de chiffrement, identité Azure.
RESTIC_REPOSITORY={{ backup_repository }}
RESTIC_PASSWORD={{ backup_restic_password }}
RESTIC_COMPRESSION={{ backup_restic_compression }}
RESTIC_CACHE_DIR=/root/.cache/restic

# Identité fédérée : restic échange le JWT écrit par le script (renouvelé
# pendant tout le run) contre un accès Azure au nom de l'identité api-rw.
AZURE_ACCOUNT_NAME={{ backup_azure_account_name }}
AZURE_CLIENT_ID={{ backup_azure_client_id }}
AZURE_TENANT_ID={{ backup_azure_tenant_id }}
AZURE_FEDERATED_TOKEN_FILE=/run/enervision-backup/federated-token.jwt
AZURE_AUTHORITY_HOST={{ backup_azure_authority_host }}

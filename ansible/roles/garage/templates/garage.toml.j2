metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"

# Snapshots de la base de métadonnées (sqlite) dans un volume dédié, à part
# de metadata_dir : c'est ce volume que le rôle Ansible `backup` sauvegarde,
# via `garage meta snapshot` (copie cohérente, la base vivante étant en WAL).
metadata_snapshots_dir = "/var/lib/garage/snapshots"

db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "garage:3901"
rpc_secret = "{{ garage_rpc_secret }}"

[s3_api]
s3_region = "{{ garage_s3_region }}"
api_bind_addr = "[::]:3900"
root_domain = "{{ garage_s3_root_domain }}"

[s3_web]
bind_addr = "[::]:3902"
root_domain = "{{ garage_web_root_domain }}"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{ garage_admin_token }}"
metrics_token = "{{ garage_metrics_token }}"
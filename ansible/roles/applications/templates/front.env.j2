# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Aucune valeur ici n'est un secret : ce
# sont des adresses de service, que le navigateur voit de toute façon dans ses
# requêtes. NE JAMAIS y placer de secret : le dashboard republie ces valeurs
# en clair sur /config.js, lisible par quiconque ouvre la page.
#
# Clés = variables lues au DÉMARRAGE du conteneur, pas au build. L'image est
# construite une seule fois par commit et déployée telle quelle : y figer des
# domaines imposerait une image par environnement.

# Origines que le navigateur a le droit d'appeler depuis le dashboard
# (directive connect-src de sa CSP), séparées par des espaces. Le front et
# l'API sont sur deux hôtes distincts, donc deux origines : sans cette liste,
# le navigateur refuse la requête avant même de l'émettre.
#
# Symétrique de CORS_ALLOWED_ORIGINS côté API : celle-ci autorise l'émission,
# l'autre la lecture de la réponse. Il faut les deux.
CSP_CONNECT_SRC={{ applications_front_csp_connect_src }}

# Adresse de l'API métier telle que le NAVIGATEUR doit la joindre — l'hôte
# public, jamais le nom de service Docker : c'est le poste de l'utilisateur qui
# émet l'appel, pas le conteneur du front.
API_BASE_URL={{ applications_front_api_base_url }}

# Origine de la série prédite : api ou fixture.
PREDICTION_SOURCE={{ applications_front_prediction_source }}

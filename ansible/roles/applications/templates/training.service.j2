# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
[Unit]
Description=EnerVision — réentraînement du modèle de prévision
Documentation=https://github.com/EnerVision-G5/predict
After=docker.service
Requires=docker.service

# Plan de secours : une seule reprise, et espacée. Un job tué à son
# plafond mémoire échouera de la même façon s'il repart tout de suite ;
# un quart d'heure plus tard, la machine peut avoir rendu ce qui manquait.
# Au-delà, l'unité reste en échec — c'est un incident à lire, pas une
# boucle à entretenir, et l'alerte Grafana le dit.
StartLimitIntervalSec={{ applications_jobs_restart_window_seconds }}
StartLimitBurst={{ applications_jobs_restart_attempts }}

[Service]
Type=oneshot
# Le compose du service est déposé par le rôle mais jamais démarré : c'est
# `run` qui crée un conteneur éphémère, le suit jusqu'à la fin, et rend son
# code de sortie. -T parce qu'un timer n'a pas de terminal à allouer, et
# --profile jobs parce que le service est justement retiré des démarrages
# ordinaires par ce profil.
WorkingDirectory={{ applications_dir }}/training
ExecStart=/usr/bin/flock --wait {{ applications_jobs_lock_wait_seconds }} \
  {{ applications_jobs_lock }} \
  /usr/bin/docker compose \
  --project-name enervision-training \
  --profile jobs \
  run --rm -T training \
  --history-days {{ applications_training_history_days }}{% if applications_training_challenge | bool %} \
  --challenge{% endif %}{% if applications_training_promote | bool %} \
  --promote{% endif %}

# Un entraînement sur {{ applications_training_history_days }} journées dure
# des dizaines de minutes. Sans cette borne, systemd tuerait le service au
# bout de 90 s en laissant un run MLflow ouvert derrière lui.
TimeoutStartSec={{ applications_training_timeout_seconds }}

# 3 = promotion refusée par la règle : verdict normal d'une semaine sans
# progrès, pas une panne. Sans cette ligne, Restart=on-failure relancerait
# l'entraînement pour obtenir le même verdict. Les vrais échecs sortent en 1.
SuccessExitStatus=3

# Reprise sur échec, dans la limite posée par StartLimit* ci-dessus.
Restart=on-failure
RestartSec={{ applications_jobs_restart_delay_seconds }}

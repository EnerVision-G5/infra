# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Collector (dépôt `collector`) — poller : interroge l'API mock et pousse les
# mesures dans Kafka (topic energy.data.raw). Processus long, sans port.
#
# Le code est actuellement hardcodé (bootstrap kafka:9092, http://mock-api:8000,
# topic, sites, intervalle 60 s) : ce compose lance l'image telle quelle. Le
# `.env` généré est vide pour l'instant — voir collector.env.j2.
services:
  collector:
    image: {{ applications_image_namespace }}/{{ applications_collector_image_name }}:{{ applications_collector_sha }}
    container_name: enervision-collector
    restart: unless-stopped
    # Producteur sans état : le relancer ne coûte que son démarrage. Il cède le
    # pas à tout ce qui porte de la donnée si la VM manque de mémoire.
    oom_score_adj: 500

    env_file:
      - .env

    networks:
{% for network in applications_collector_networks %}
      - {{ network }}
{% endfor %}

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

    deploy:
      resources:
        limits:
          memory: {{ applications_collector_memory_limit }}
          cpus: "{{ applications_collector_cpu_limit }}"

networks:
{% for network in applications_collector_networks %}
  {{ network }}:
    external: true
    name: {{ network }}
{% endfor %}

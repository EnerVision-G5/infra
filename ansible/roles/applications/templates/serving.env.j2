# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Cible : image predict/serving (uvicorn, port {{ applications_serving_port }}).
# La configuration de predict est un YAML en couches
# (conf/base.yaml + conf/${PREDICT_ENV}.yaml embarqués dans l'image) ; ce
# fichier ne fournit que les ${VARIABLE} que ce YAML résout dans
# l'environnement.
PREDICT_ENV={{ applications_serving_env }}

# storage.root — partitions de variables produites par l'ETL (chemin local ou
# URI s3:// vers Garage).
PREDICT_STORAGE_ROOT={{ applications_predict_storage_root }}

# mlflow.tracking_uri / serving.model_uri — registre d'où le modèle est résolu.
MLFLOW_TRACKING_URI={{ applications_predict_mlflow_tracking_uri }}
SERVING_MODEL_URI={{ applications_serving_model_uri }}
{% if applications_predict_s3_access_key_id | length > 0 %}

# Accès au stockage objet Garage — pas d'AWS ici : Garage parle le protocole
# S3, et AWS_ENDPOINT_URL est ce qui détourne la bibliothèque cliente
# d'amazonaws.com vers le nœud interne. La région entre dans la signature de
# chaque requête et doit être celle qu'annonce ce nœud.
# Sans ces lignes, une racine s3:// donnerait un service qui démarre et ne
# trouve aucune partition à relire.
AWS_ENDPOINT_URL={{ applications_predict_s3_endpoint_url }}
AWS_REGION={{ applications_predict_s3_region }}
AWS_DEFAULT_REGION={{ applications_predict_s3_region }}
AWS_ACCESS_KEY_ID={{ applications_predict_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ applications_predict_s3_secret_access_key }}
{% endif %}

# Pas de DATABASE_URL : serving ne touche pas la base. Les jobs batch predict
# (collector, etl, training) qui, eux, écrivent la table `mesure`, reçoivent
# DATABASE_URL en dialecte psycopg dans leur propre .env.

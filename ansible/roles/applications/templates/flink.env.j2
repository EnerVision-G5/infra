# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Lu par le job à la soumission (EnergyRollingJob.getEnvironmentVariable).
# FLINK_PROPERTIES (multi-ligne) est dans le compose, pas ici.

KAFKA_BOOTSTRAP_SERVERS={{ applications_flink_kafka_bootstrap }}
KAFKA_INPUT_TOPIC={{ applications_flink_kafka_input_topic }}
KAFKA_OUTPUT_TOPIC={{ applications_flink_kafka_output_topic }}
KAFKA_GROUP_ID={{ applications_flink_kafka_group_id }}

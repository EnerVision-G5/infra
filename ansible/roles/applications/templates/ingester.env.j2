# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Partagé par les trois conteneurs de
# l'ingester ; chacun n'en lit que ce dont il a besoin (app/config.py).

# Base — dialecte psycopg (SQLAlchemy synchrone). urlencode sur le mot de passe.
DATABASE_URL={{ applications_ingester_database_url }}

# Kafka.
KAFKA_BOOTSTRAP_SERVERS={{ applications_ingester_kafka_bootstrap }}
KAFKA_TOPIC={{ applications_ingester_raw_topic }}
KAFKA_GROUP_ID={{ applications_ingester_raw_group_id }}
KAFKA_ENRICHED_TOPIC={{ applications_ingester_enriched_topic }}
KAFKA_ENRICHED_GROUP_ID={{ applications_ingester_enriched_group_id }}

# site-sync : API source du référentiel (GET /api/v1/sites).
MOCK_API_URL={{ applications_ingester_mock_api_url }}

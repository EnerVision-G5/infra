# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
ENVIRONMENT={{ applications_api_environment }}

# L'ETL écrit les colonnes d'imputation et mesure_exclu, jamais la valeur
# brute que le collecteur a déposée.
DATABASE_URL={{ applications_etl_database_url }}

# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Même configuration en couches que le collector : le YAML embarqué dans
# l'image résout les ${VARIABLE} fournies ici.
PREDICT_ENV={{ applications_etl_env }}
{% if applications_predict_feature_version | length > 0 %}

# etl.feature_version / etl.lag_hours — AMORÇAGE.
# Une heure n'est publiée que si tous ses décalages existent : tant que la
# collecte est plus jeune que 168 h, la journée sort vide. Le jeu réduit
# produit des variables tout de suite, sans la saisonnalité hebdomadaire,
# et sous SA PROPRE version pour ne pas mêler deux jeux de colonnes dans un
# même chemin de partitions. Les trois services lisent les mêmes valeurs :
# l'ETL écrit là, serving y résout ses partitions, training y apprend.
ETL_FEATURE_VERSION={{ applications_predict_feature_version }}
ETL_LAG_HOURS={{ applications_predict_lag_hours }}
{% endif %}

# database.url — dialecte psycopg (SQLAlchemy synchrone). L'ETL écrit les
# colonnes d'imputation et mesure_exclu, jamais la valeur brute.
DATABASE_URL={{ applications_etl_database_url }}

# storage.root — DESTINATION des partitions de variables. C'est la même racine
# que celle lue par serving et training : laissée au défaut, l'ETL écrirait
# dans son propre conteneur et les deux autres liraient un stockage vide.
PREDICT_STORAGE_ROOT={{ applications_predict_storage_root }}
{% if applications_predict_s3_access_key_id | length > 0 %}

# Accès au stockage objet Garage — pas d'AWS ici : Garage parle le protocole
# S3, et AWS_ENDPOINT_URL est ce qui détourne la bibliothèque cliente
# d'amazonaws.com vers le nœud interne. La région entre dans la signature de
# chaque requête et doit être celle qu'annonce ce nœud.
# Sans ces lignes, une racine s3:// donnerait un ETL qui transforme puis
# échoue à publier.
AWS_ENDPOINT_URL={{ applications_predict_s3_endpoint_url }}
AWS_REGION={{ applications_predict_s3_region }}
AWS_DEFAULT_REGION={{ applications_predict_s3_region }}
AWS_ACCESS_KEY_ID={{ applications_predict_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ applications_predict_s3_secret_access_key }}
{% endif %}

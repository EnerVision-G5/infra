# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Clés = variables lues par app/core/config.py (pydantic-settings).
APP_NAME={{ applications_api_app_name }}
ENVIRONMENT={{ applications_api_environment }}
DEBUG={{ applications_api_debug | lower }}

# Base : dialecte asyncpg (SQLAlchemy asynchrone).
DATABASE_URL={{ applications_api_database_url }}

# Authentification JWT. JWT_SECRET : >= 32 caractères, sinon l'API ne démarre
# pas (validée au démarrage par app/main.py:lifespan).
AUTH_ENABLED={{ applications_api_auth_enabled | lower }}
JWT_SECRET={{ applications_api_jwt_secret }}
JWT_ALGORITHM={{ applications_api_jwt_algorithm }}
ACCESS_TOKEN_EXPIRE_MINUTES={{ applications_api_access_token_expire_minutes }}

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Le front est servi sur une autre origine : sans cette liste, le
# navigateur bloque toutes ses requêtes avant même de les envoyer.
CORS_ALLOWED_ORIGINS={{ applications_api_cors_allowed_origins }}

# Le service d'inférence (predict/serving) a quitté ce rôle : la chaîne ML est
# en cours de reconstruction (Kafka → ingester → …). Les variables PREDICT_*
# reviendront ici quand la nouvelle chaîne exposera un point d'inférence.

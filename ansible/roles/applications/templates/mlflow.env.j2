# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Le registre se règle en ligne de commande (voir son compose), pas par la
# configuration en couches de predict : ce fichier ne porte donc que ce que
# MLflow et la bibliothèque AWS lisent dans l'environnement.
{% if applications_mlflow_expose | bool %}

# Origine de l'interface publique. MLflow 3 refuse toute requête d'écriture
# portant une origine inconnue, et cette liste ne se déduit pas de
# --allowed-hosts : sans elle, l'interface s'affiche mais chaque appel
# /ajax-api répond 403. Le schéma en fait partie — une origine annoncée en
# https devant un service servi en http est une origine DIFFÉRENTE.
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS={{ applications_mlflow_cors_allowed_origins }}
{% endif %}
{% if applications_mlflow_artifacts_destination.startswith('s3://') %}
# Artefacts déposés sur le stockage objet Garage. Le registre les sert lui-même
# à ses clients (proxy), qui n'ont donc pas besoin d'accéder au seau.
AWS_ENDPOINT_URL={{ applications_predict_s3_endpoint_url }}
# MLflow résout le point d'accès par sa propre variable avant de regarder
# celle de boto3 : les anciennes versions de la bibliothèque ne lisent que
# celle-ci, et un registre qui l'ignore repart vers amazonaws.com.
MLFLOW_S3_ENDPOINT_URL={{ applications_predict_s3_endpoint_url }}
AWS_REGION={{ applications_predict_s3_region }}
AWS_DEFAULT_REGION={{ applications_predict_s3_region }}
AWS_ACCESS_KEY_ID={{ applications_predict_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ applications_predict_s3_secret_access_key }}
{% else %}
# Artefacts sur le volume mlruns ({{ applications_mlflow_artifacts_destination }}) :
# aucun accès au stockage objet n'est nécessaire. Basculer
# applications_mlflow_artifacts_destination sur une URI s3:// ajoute ici les
# identifiants Garage et storage_network au service.
{% endif %}

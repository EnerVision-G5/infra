# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Clés lues par app/config.py.
# Aucun secret applicatif : base interne + registre MLflow interne.

APP_PORT={{ applications_prediction_api_port }}

# Base — dialecte psycopg, urlencode sur le mot de passe (SQL brut sur
# energy_readings, pas de modèle partagé).
DATABASE_URL={{ applications_prediction_api_database_url }}

# Modèle servi : résolu par alias dans le registre MLflow au premier appel.
# MLflow proxifie les artefacts (--serve-artifacts) : rien d'autre à joindre.
MLFLOW_TRACKING_URI={{ applications_prediction_api_mlflow_tracking_uri }}
MLFLOW_REGISTERED_MODEL={{ applications_prediction_api_mlflow_model }}
MLFLOW_MODEL_ALIAS={{ applications_prediction_api_mlflow_alias }}

HISTORY_HOURS={{ applications_prediction_api_history_hours }}

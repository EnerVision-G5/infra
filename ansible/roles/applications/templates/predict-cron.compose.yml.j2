# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Rafraîchissement des prédictions (kind: worker).
#
# Porté par l'image de l'API : le job vit dans son code
# (app.jobs.predict_refresh), il n'a donc ni image ni version propres.
#
# Conteneur dédié plutôt qu'ordonnanceur embarqué dans l'API : celle-ci reste
# sans état, et le job est rejouable à la main sans la redémarrer. Pas de
# port, pas de route Traefik.
services:
  predict-cron:
    image: {{ applications_image_namespace }}/{{ applications_api_image_name }}:{{ applications_api_sha }}
    container_name: enervision-predict-cron
    restart: unless-stopped

    entrypoint: ["/bin/sh", "-c"]
    command:
      # Le job rend un code non nul quand tous les sites ont échoué. Il est
      # journalisé sans arrêter la boucle : une panne du service d'inférence
      # ne doit pas laisser le rafraîchissement mort jusqu'à la prochaine
      # intervention.
      - >-
        while :; do
        python -m app.jobs.predict_refresh
        || echo "predict_refresh sorti en erreur, voir les lignes ci-dessus";
        sleep {{ applications_predict_cron_period_seconds }};
        done

    env_file:
      - .env

    networks:
      - db_network
      - ml_network

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

networks:
  db_network:
    external: true
    name: db_network

  ml_network:
    external: true
    name: ml_network

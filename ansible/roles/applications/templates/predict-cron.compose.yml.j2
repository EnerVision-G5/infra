# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Rafraîchissement horaire des prédictions. Réutilise l'image de l'API : le
# job vit dans son code (app.jobs.predict_refresh), il n'a donc ni image ni
# version propres et suit celle de l'API.
#
# Conteneur dédié plutôt qu'ordonnanceur embarqué dans l'API : celle-ci reste
# sans état, et le job est rejouable à la main sans la redémarrer.
#
# Le conteneur reste en vie et son entrypoint attend l'heure suivante. Le code
# de sortie du job est journalisé sans arrêter la boucle : une panne isolée ne
# doit pas laisser le service mort jusqu'à la prochaine intervention.
services:
  predict-cron:
    image: {{ applications_image_namespace }}/{{ applications_api_image_name }}:{{ applications_api_sha }}
    container_name: enervision-predict-cron
    restart: unless-stopped

    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        while :; do
        python -m app.jobs.predict_refresh
        || echo "predict_refresh sorti en erreur, voir les lignes ci-dessus";
        sleep {{ applications_predict_cron_period_seconds }};
        done

    env_file:
      - .env

    networks:
      - db_network
      - ml_network

networks:
  db_network:
    external: true
    name: db_network

  ml_network:
    external: true
    name: ml_network

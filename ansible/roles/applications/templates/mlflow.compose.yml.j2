# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Registre de modèles MLflow (kind: web).
#
# Porté par l'image predict/training, qui embarque MLflow : le serveur qui
# écrit les runs et le client qui les produit sont alors exactement de la même
# version. Pivot de la chaîne ML — training y enregistre ses versions, serving
# y résout l'alias du modèle qu'il sert.
services:
  mlflow:
    image: {{ applications_image_namespace }}/{{ applications_training_image_name }}:{{ applications_training_sha }}
    container_name: enervision-mlflow
    restart: unless-stopped

    # L'image sert `python -m training` : le registre redéclare son point
    # d'entrée pour lancer le serveur au lieu d'un entraînement.
    entrypoint: ["mlflow"]
    command:
      - server
      - --host=0.0.0.0
      - --port={{ applications_mlflow_port }}
      - --backend-store-uri={{ applications_mlflow_backend_store_uri }}
      - --artifacts-destination={{ applications_mlflow_artifacts_destination }}
      - --allowed-hosts={{ (applications_mlflow_allowed_hosts + ([applications_mlflow_host] if applications_mlflow_expose | bool else [])) | join(',') }}

    env_file:
      - .env

    # Publié sur la seule boucle locale de l'hôte : l'interface se consulte par
    # un tunnel SSH (ssh -L {{ applications_mlflow_port }}:127.0.0.1:{{ applications_mlflow_port }})
    # sans être joignable depuis le réseau. C'est ce qui rend l'absence de
    # route Traefik tenable : le registre reste consultable sans être ouvert.
    ports:
      - "127.0.0.1:{{ applications_mlflow_port }}:{{ applications_mlflow_port }}"

    # Le backend store et les artefacts vivent ici, hors de l'image : les runs
    # et les versions enregistrées survivent à un redéploiement. Le répertoire
    # appartient à l'uid 10001 dans l'image, sans quoi le serveur boucle sur
    # « unable to open database file ».
    volumes:
      - mlruns:/mlruns

    networks:
      - ml_network
{% if applications_mlflow_expose | bool %}
      - proxy_network
{% endif %}
{% if applications_mlflow_artifacts_destination.startswith('s3://') %}
      - storage_network
{% endif %}

    healthcheck:
      test:
        - CMD-SHELL
        - python -c "import urllib.request; urllib.request.urlopen('http://localhost:{{ applications_mlflow_port }}/health')"
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

    # Plafonds ressources : la VM 4 vCPU / 8 Go porte toute la stack. `cpus`
    # est un plafond (somme sur l'hôte > 4), `memory` le garde-fou anti-OOM.
    deploy:
      resources:
        limits:
          memory: {{ applications_mlflow_memory_limit }}
          cpus: "{{ applications_mlflow_cpu_limit }}"
{% if applications_mlflow_expose | bool %}

    # MLflow n'a aucune authentification propre, et déplacer un alias dans le
    # registre change le modèle servi en production. La route ne passe donc
    # jamais sans authentification basique — le rôle le vérifie avant de
    # déployer. Les $ des hachages htpasswd sont doublés : compose les lirait
    # sinon comme des variables à substituer.
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy_network"

      - "traefik.http.middlewares.enervision-mlflow-auth.basicauth.users={{ applications_mlflow_basic_auth_users | replace('$', '$$') }}"

      - 'traefik.http.routers.enervision-mlflow.rule=Host(`{{ applications_mlflow_host }}`)'
      - "traefik.http.routers.enervision-mlflow.entrypoints={{ traefik_entrypoint }}"
      # - "traefik.http.routers.enervision-mlflow.tls=true"
      # - "traefik.http.routers.enervision-mlflow.tls.certresolver={{ traefik_certresolver }}"
      - "traefik.http.routers.enervision-mlflow.middlewares=enervision-mlflow-auth"
      - "traefik.http.routers.enervision-mlflow.service=enervision-mlflow"
      - "traefik.http.services.enervision-mlflow.loadbalancer.server.port={{ applications_mlflow_port }}"
{% endif %}

volumes:
  mlruns:
    driver: local

networks:
  ml_network:
    external: true
    name: ml_network
{% if applications_mlflow_expose | bool %}

  proxy_network:
    external: true
    name: proxy_network
{% endif %}
{% if applications_mlflow_artifacts_destination.startswith('s3://') %}

  storage_network:
    external: true
    name: storage_network
{% endif %}

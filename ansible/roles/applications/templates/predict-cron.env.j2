# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Même image que l'API, mais seules les variables du job servent ici : ni
# JWT_SECRET ni CORS, le job n'expose aucun endpoint.
ENVIRONMENT={{ applications_api_environment }}

# C'est l'API qui écrit la table prediction, jamais le service d'inférence.
DATABASE_URL={{ applications_api_database_url }}

PREDICT_URL={{ applications_predict_url }}
PREDICT_HORIZON_HOURS={{ applications_predict_horizon_hours }}
PREDICT_TIMEOUT_SECONDS={{ applications_predict_timeout_seconds }}

# Clé présentée au service d'inférence en en-tête X-API-Key. C'est ce job qui
# alimente la table `prediction` : sans la bonne clé, chaque site revient en
# 401, rien n'est archivé, et le dashboard n'a plus rien à afficher.
PREDICT_API_KEY={{ applications_predict_api_key }}

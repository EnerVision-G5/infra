# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Cible : service serving (uvicorn, port {{ applications_predict_port }}). La
# configuration de predict est un YAML en couches
# (conf/base.yaml + conf/${PREDICT_ENV}.yaml embarqués dans l'image) ; ce
# fichier ne fournit que les ${VARIABLE} que ce YAML résout dans
# l'environnement.
PREDICT_ENV={{ applications_predict_env }}

# storage.root — partitions de variables produites par l'ETL (chemin local ou
# URI s3:// vers Garage).
PREDICT_STORAGE_ROOT={{ applications_predict_storage_root }}

# mlflow.tracking_uri / serving.model_uri — registre d'où le modèle est résolu.
MLFLOW_TRACKING_URI={{ applications_predict_mlflow_tracking_uri }}
SERVING_MODEL_URI={{ applications_predict_serving_model_uri }}

# Pas de DATABASE_URL : serving ne touche pas la base. Les jobs batch predict
# (collector, etl, training) qui, eux, écrivent la table `mesure`, ont besoin
# de DATABASE_URL en dialecte psycopg (applications_predict_database_url) et
# d'un déploiement propre — ils ne passent pas par ce rôle.

# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Réentraînement du modèle EnerVision (image predict/training, kind: job).
#
# Traitement daté : il apprend sur une fenêtre glissante, enregistre une
# version dans MLflow, et sort. Le rôle dépose ce compose mais ne le démarre
# jamais — c'est training.timer qui le lance par `docker compose run --rm`.
# Un `up` rejouerait un entraînement complet à chaque déploiement.
#
# Deux gardes pour cela : le profil `jobs`, qui exclut le service d'un `up`
# lancé à la main sur l'hôte, et l'absence de container_name, que
# `docker compose run` refuse — il nomme lui-même le conteneur éphémère.
services:
  training:
    image: {{ applications_image_namespace }}/{{ applications_training_image_name }}:{{ applications_training_sha }}
    profiles: ["jobs"]
    # Un entraînement qui échoue est un incident à lire, pas à rejouer en
    # boucle : le timer repassera à la prochaine échéance.
    restart: "no"

    env_file:
      - .env

    networks:
      # Registre MLflow : c'est lui qui reçoit le run et la version produite.
      - ml_network
      # Partitions de variables lues sur Garage.
      - storage_network
      # Base : lue par --promote seul, qui inscrit la version mise en service
      # dans la table `modele`. Déclarée même sans promotion, pour qu'une
      # promotion demandée n'échoue pas après avoir appris.
      - db_network

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

  # Surveillance de dérive. Même image que l'entraînement — c'est le même
  # paquet — mais un autre point d'entrée : `python -m training.drift` là où
  # l'image sert `python -m training`. Déclarée ici plutôt que dans son propre
  # compose pour cette raison : deux répertoires de déploiement pour une seule
  # image feraient deux endroits où épingler la même version.
  #
  # Derrière le profil `jobs` comme l'entraînement, et jamais démarrée par un
  # `up`. C'est drift.timer qui la lance, quotidiennement.
  #
  # Le code de sortie porte le verdict : 0 stable, 2 dérive, 1 le calcul a
  # échoué. Voir drift.service pour ce que systemd en fait.
  drift:
    image: {{ applications_image_namespace }}/{{ applications_training_image_name }}:{{ applications_training_sha }}
    profiles: ["jobs"]
    restart: "no"
    entrypoint: ["python", "-m", "training.drift"]

    env_file:
      - .env

    networks:
      # Registre MLflow : la surveillance y résout le modèle SERVI, et y
      # dépose ses mesures dans sa propre expérience.
      - ml_network
      # Partitions de variables : c'est sur elles qu'elle rejoue le modèle,
      # pas sur la couche brute.
      - storage_network

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

networks:
  ml_network:
    external: true
    name: ml_network

  storage_network:
    external: true
    name: storage_network

  db_network:
    external: true
    name: db_network

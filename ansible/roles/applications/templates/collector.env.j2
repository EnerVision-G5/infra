# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Partagé par le poller (compose) et le rattrapage daté (timer systemd). La
# configuration de predict est un YAML en couches (conf/base.yaml embarqué
# dans l'image) ; ce fichier ne fournit que les ${VARIABLE} qu'elle résout.
PREDICT_ENV={{ applications_collector_env }}

# database.url — dialecte psycopg (SQLAlchemy synchrone). Le collector écrit
# la table `mesure` : sans cette variable il refuse de démarrer.
DATABASE_URL={{ applications_collector_database_url }}

# source.base_url — API Mock IoT interrogée pour les mesures.
MOCK_API_URL={{ applications_collector_mock_api_url }}

# collector.catch_up_days — fenêtre dans laquelle le poller cherche les trous
# avant d'entrer dans sa boucle. Sans ce rattrapage, un poller qui redémarre
# reprend AU PRÉSENT et laisse derrière lui tout ce que la coupure a laissé
# passer, sans que rien ne le signale.
COLLECTOR_CATCH_UP_DAYS={{ applications_collector_catch_up_days }}

# storage.datasets_root — historique de référence, chargé UNE FOIS par
# `python -m collector.datasets`. Il n'est ni dans le dépôt ni dans l'image :
# vingt-quatre mégaoctets de CSV figés n'ont à grossir ni les clones ni les
# couches publiées. Le poller ne le lit jamais ; la variable est ici parce que
# les deux usages partagent ce fichier.
PREDICT_DATASETS_ROOT={{ applications_predict_datasets_root }}
{% if applications_predict_s3_access_key_id | length > 0 %}

# Accès au stockage objet Garage — pas d'AWS ici : Garage parle le protocole
# S3, et AWS_ENDPOINT_URL est ce qui détourne la bibliothèque cliente
# d'amazonaws.com vers le nœud interne. La région entre dans la signature de
# chaque requête et doit être celle qu'annonce ce nœud.
# Sans ces lignes, une racine s3:// donnerait un import qui échoue avant
# d'avoir lu son premier fichier.
AWS_ENDPOINT_URL={{ applications_predict_s3_endpoint_url }}
AWS_REGION={{ applications_predict_s3_region }}
AWS_DEFAULT_REGION={{ applications_predict_s3_region }}
AWS_ACCESS_KEY_ID={{ applications_predict_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ applications_predict_s3_secret_access_key }}
{% endif %}

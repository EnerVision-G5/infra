# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Partagé par le poller (compose) et le rattrapage daté (timer systemd). La
# configuration de predict est un YAML en couches (conf/base.yaml embarqué
# dans l'image) ; ce fichier ne fournit que les ${VARIABLE} qu'elle résout.
PREDICT_ENV={{ applications_collector_env }}

# database.url — dialecte psycopg (SQLAlchemy synchrone). Le collector écrit
# la table `mesure` : sans cette variable il refuse de démarrer.
DATABASE_URL={{ applications_collector_database_url }}

# source.base_url — API Mock IoT interrogée pour les mesures.
MOCK_API_URL={{ applications_collector_mock_api_url }}

# collector.catch_up_days — fenêtre dans laquelle le poller cherche les trous
# avant d'entrer dans sa boucle. Sans ce rattrapage, un poller qui redémarre
# reprend AU PRÉSENT et laisse derrière lui tout ce que la coupure a laissé
# passer, sans que rien ne le signale.
COLLECTOR_CATCH_UP_DAYS={{ applications_collector_catch_up_days }}

# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Clés lues par le code du collector
# (os.getenv, voir .env.example du dépôt).

# API source des mesures (mock IoT).
MOCK_API_URL={{ applications_collector_mock_api_url }}

# Broker Kafka.
KAFKA_BOOTSTRAP={{ applications_collector_kafka_bootstrap }}
KAFKA_TOPIC={{ applications_collector_kafka_topic }}

# Poller : intervalle entre deux cycles, en secondes.
POLL_INTERVAL={{ applications_collector_poll_interval }}

# Sites interrogés, séparés par des virgules.
SITES={{ applications_collector_sites }}

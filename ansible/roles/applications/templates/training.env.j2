# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Cible : image predict/training, lancée par training.timer. Même
# configuration en couches que les autres services du dépôt : le YAML embarqué
# dans l'image résout les ${VARIABLE} fournies ici.
PREDICT_ENV={{ applications_training_env }}

# storage.root — partitions de variables produites par l'ETL. L'entraînement
# n'apprend que ce que l'ETL a publié : la couche brute ne l'intéresse pas.
PREDICT_STORAGE_ROOT={{ applications_predict_storage_root }}

# mlflow.tracking_uri / training.experiment — où atterrissent le run, les
# métriques et la version enregistrée du modèle.
MLFLOW_TRACKING_URI={{ applications_predict_mlflow_tracking_uri }}
MLFLOW_EXPERIMENT={{ applications_training_experiment }}

# monitoring.experiment — où atterrissent les mesures de dérive. Séparée de
# l'expérience d'entraînement, et pas par goût du rangement : mélanger les
# deux rendrait illisible la comparaison entre modèles, chaque run de
# surveillance venant s'intercaler entre deux entraînements.
#
# Le fichier est partagé par les deux services du compose : l'entraînement
# ignore cette clé, la surveillance ignore MLFLOW_EXPERIMENT.
MLFLOW_DRIFT_EXPERIMENT={{ applications_drift_experiment }}

# monitoring.mae_alert_ratio — seuil d'alerte, exprimé en RAPPORT à l'erreur
# du modèle sur son jeu de test au moment de l'entraînement, jamais en
# kilowatts. Un seuil absolu vaudrait pour un site de 200 kW et serait absurde
# pour un autre de 1000, et il faudrait le réviser à chaque réentraînement.
DRIFT_ALERT_RATIO={{ applications_drift_alert_ratio }}

# database.url — dialecte psycopg (SQLAlchemy synchrone). Lue par --promote
# seul, qui inscrit la version mise en service dans la table `modele`.
DATABASE_URL={{ applications_training_database_url }}
{% if applications_predict_s3_access_key_id | length > 0 %}

# Accès au stockage objet Garage — pas d'AWS ici : Garage parle le protocole
# S3, et AWS_ENDPOINT_URL est ce qui détourne la bibliothèque cliente
# d'amazonaws.com vers le nœud interne. La région entre dans la signature de
# chaque requête et doit être celle qu'annonce ce nœud.
# Sans ces lignes, une racine s3:// donnerait un entraînement qui ne trouve
# aucune partition à apprendre.
AWS_ENDPOINT_URL={{ applications_predict_s3_endpoint_url }}
AWS_REGION={{ applications_predict_s3_region }}
AWS_DEFAULT_REGION={{ applications_predict_s3_region }}
AWS_ACCESS_KEY_ID={{ applications_predict_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ applications_predict_s3_secret_access_key }}
{% endif %}

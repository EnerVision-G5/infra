# Déployé par le rôle Ansible "applications" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Clés lues par app/config.py + app/blob.py.
#
# Aucun secret ici : l'accès Azure passe par la clé privée de l'émetteur,
# montée à part ({{ applications_workload_key_path_in_container }}).

# Kafka
KAFKA_BOOTSTRAP_SERVERS={{ applications_raw_archiver_kafka_bootstrap }}
KAFKA_TOPIC={{ applications_raw_archiver_kafka_topic }}
KAFKA_GROUP_ID={{ applications_raw_archiver_kafka_group_id }}

# Stockage Azure Blob (compte du projet, conteneur de l'environnement).
BLOB_ACCOUNT_URL={{ applications_blob_account_url }}
BLOB_CONTAINER={{ applications_blob_container }}
BLOB_PREFIX={{ applications_raw_archiver_blob_prefix }}

# Identité fédérée : le service signe un JWT avec la clé privée, Entra ID
# l'échange contre l'identité managée `api-rw` (écriture).
AZURE_TENANT_ID={{ applications_azure_tenant_id }}
AZURE_CLIENT_ID={{ applications_raw_archiver_azure_client_id }}
WORKLOAD_ISSUER={{ applications_workload_issuer }}
WORKLOAD_SUBJECT={{ applications_raw_archiver_workload_subject }}
WORKLOAD_KID={{ applications_workload_kid }}
WORKLOAD_KEY_FILE={{ applications_workload_key_path_in_container }}

# Flush du buffer vers le blob.
FLUSH_INTERVAL_SECONDS={{ applications_raw_archiver_flush_interval_seconds }}
FLUSH_MAX_ROWS={{ applications_raw_archiver_flush_max_rows }}

# Déployé par le rôle Ansible "mlflow" — ne pas éditer sur l'hôte.
# Fichier hors Git (cf. .gitignore). Les valeurs sensibles proviennent de
# variables chiffrées avec ansible-vault.
#
# Le serveur se règle en ligne de commande (voir son compose) ; ce fichier ne
# porte que ce que MLflow et le client Azure lisent dans l'environnement.
{% if mlflow_artifacts_destination.startswith('wasbs://') %}
# Artefacts sur Azure Blob. MLflow les sert lui-même à ses clients (proxy,
# --serve-artifacts) : serving et training n'ont besoin que de MLFLOW_TRACKING_URI.
AZURE_STORAGE_CONNECTION_STRING={{ mlflow_azure_connection_string }}
{% else %}
# Artefacts sur le volume local ({{ mlflow_artifacts_destination }}) : aucune
# connexion Azure. Basculer mlflow_artifacts_destination sur une URI wasbs://
# ajoute ici AZURE_STORAGE_CONNECTION_STRING.
{% endif %}

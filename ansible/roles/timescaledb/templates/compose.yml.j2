# Déployé par le rôle Ansible "timescaledb" — ne pas éditer sur l'hôte.
# Base EnerVision (TimescaleDB / PG16). Le schéma vient des scripts SQL de
# ./initdb, copiés par le rôle depuis enervision-db/initdb : ce sont eux la
# source de vérité, pas les modèles de l'API.
#
# Ces scripts ne sont joués qu'au premier démarrage, volume de données vide.
services:
  timescaledb:
    image: {{ timescaledb_image }}
    container_name: timescaledb
    restart: unless-stopped

    ports:
      - "{{ timescaledb_bind_address }}:{{ timescaledb_port }}:5432"

    environment:
      POSTGRES_DB: ${POSTGRES_DB:?definir POSTGRES_DB dans .env}
      POSTGRES_USER: ${POSTGRES_USER:?definir POSTGRES_USER dans .env}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?definir POSTGRES_PASSWORD dans .env}
      # Désactive la télémétrie TimescaleDB
      TIMESCALEDB_TELEMETRY: "off"

    volumes:
      - timescaledb_data:/var/lib/postgresql/data
      # Seul le schéma est copié sur l'hôte : le seed de développement
      # (enervision-db/dev-seed) n'a rien à faire en production.
      - ./initdb:/docker-entrypoint-initdb.d:ro

    networks:
      - db_network

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5

    deploy:
      resources:
        limits:
          memory: {{ timescaledb_memory_limit }}
          cpus: "{{ timescaledb_cpu_limit }}"

volumes:
  timescaledb_data:
    driver: local

networks:
  db_network:
    external: true
    name: db_network
